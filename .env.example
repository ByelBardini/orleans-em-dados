# Porta da API local
PORT=3000

# PostgreSQL (o docker-compose.yml sobe este banco na porta 5433)
DATABASE_URL=postgres://orleans:orleans@localhost:5433/orleans_em_dados

# Pasta para os snapshots JSON opcionais (coletar --json), relativa à raiz do repositório
DATA_DIR=data

# Tamanho da página nas consultas à Betha e pausa entre páginas (ms)
BETHA_PAGE_SIZE=100
BETHA_PAUSA_MS=300
