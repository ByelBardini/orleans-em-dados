# Porta da API local
PORT=3000

# PostgreSQL (o docker-compose.yml sobe este banco na porta 5433)
DATABASE_URL=postgres://orleans:orleans@localhost:5433/orleans_em_dados

# Pasta para os snapshots JSON opcionais (coletar --json), relativa à raiz do repositório
DATA_DIR=data

# Tamanho da página nas consultas à Betha e pausa entre páginas (ms).
# A paginação por offset é instável no exercício corrente: prefira uma página só.
BETHA_PAGE_SIZE=10000
BETHA_PAUSA_MS=300

# Worker: exercícios encerrados que o histórico completa (padrão 10) e a pausa entre um e outro (ms).
ANOS_DE_HISTORICO=10
HISTORICO_PAUSA_MS=5000

# Produção: a pasta do build do web, que a API passa a servir (no desenvolvimento, o Vite serve o web).
# WEB_DIST=apps/web/dist

# Produção: o endereço público do site (canonical, prévia das redes sociais, sitemap.xml, robots.txt).
# Sem ele, o painel sobe sem URL absoluta e sem sitemap.
# SITE_URL=https://orleansemdados.com.br
# Opcional: o código da meta de verificação do Google Search Console (a propriedade por DNS dispensa).
# GOOGLE_SITE_VERIFICATION=
