{
  "name": "orleans-em-dados",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open source para centralização, visualização e análise de dados públicos do município de Orleans/SC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "db:subir": "docker compose up -d --wait",
    "db:migrar": "pnpm --filter @orleans-em-dados/db migrar",
    "db:exemplos": "pnpm --filter @orleans-em-dados/importadores importar --exemplos",
    "db:teste": "docker run -d --rm --name orleans-testar -e POSTGRES_USER=orleans -e POSTGRES_PASSWORD=orleans -e POSTGRES_DB=orleans_teste -p 5434:5432 --tmpfs /var/lib/postgresql/data postgres:17-alpine",
    "db:teste:parar": "docker rm -f orleans-testar",
    "coletar": "pnpm --filter @orleans-em-dados/importadores coletar",
    "coletar:tcesc": "pnpm --filter @orleans-em-dados/importadores coletar:tcesc",
    "conferir": "pnpm --filter @orleans-em-dados/importadores conferir",
    "importar": "pnpm --filter @orleans-em-dados/importadores importar",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @orleans-em-dados/api dev\" \"pnpm --filter @orleans-em-dados/web dev\"",
    "build": "pnpm --filter @orleans-em-dados/web build",
    "start": "pnpm --filter @orleans-em-dados/api start",
    "test": "vitest run --project=!integracao",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integracao": "vitest run --project=integracao"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^9.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.9.0"
}
