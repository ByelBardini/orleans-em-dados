{
  "name": "orleans-em-dados",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma open source para centralização, visualização e análise de dados públicos do município de Orleans/SC.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "db",
    "collectors",
    "backend",
    "frontend"
  ],
  "scripts": {
    "db:subir": "docker compose up -d --wait",
    "db:migrar": "npm run migrar -w db",
    "db:exemplos": "npm run importar -w collectors -- --exemplos",
    "coletar": "npm run coletar -w collectors --",
    "coletar:tcesc": "npm run coletar:tcesc -w collectors --",
    "importar": "npm run importar -w collectors --",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
